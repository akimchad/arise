# --- Database (Emergent provides MONGO_URL / DB_NAME automatically) ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=arise

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Higgsfield API (https://console.higgsfield.ai -> API keys), format key_id:key_secret ---
# Billed from the API's prepaid USD balance (separate from higgsfield.ai web credits).
HF_CREDENTIALS=
# Models: GPT Image 2.5 Sunburst for images, Wan 3.0 for reels (override if you like)
# HF_IMAGE_ENDPOINT=marketing-studio/image/sunburst
# HF_VIDEO_ENDPOINT=alibaba/wan-3.0/image-to-video
# image = render Arise's prompt with HF_IMAGE_ENDPOINT (default) | ads = Ads Studio writes + renders the concept
# HF_IMAGE_ENGINE=image

# --- Optional: Claude for brand analysis, live trend research and ideas ---
ANTHROPIC_API_KEY=
# live = real generations (needs HF_CREDENTIALS), demo = replays showcase media
# GENERATION_MODE=live

# --- Fair-use limits per account per UTC day ---
DAILY_IMAGE_LIMIT=8
DAILY_VIDEO_LIMIT=2

# Public URL of the deployed app (used for share links)
PUBLIC_URL=
